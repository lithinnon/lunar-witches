#!/usr/bin/env python3
"""
Neverness to Everness (NTE) Config Sync Tool
Thin wrapper using acg_config_sync core engine with read-only locking.
"""

from pathlib import Path
from acg_config_sync import ACGConfigEngine

NTE_CONFIG_DIR = Path.home() / ".local/share/Steam/steamapps/compatdata/4508340/pfx/drive_c/users/steamuser/AppData/Local/HT/Saved_GlobalSteam/Config/Windows"
NTE_CACHE_DIR = Path.home() / ".cache/nte-configs"
NTE_REPO_URL = "https://github.com/AlteriaX/NTE-Configs.git"
NTE_COMMON_FILES = ["DeviceProfiles.ini", "Game.ini", "Input.ini"]

def main():
    engine = ACGConfigEngine(
        game_name="Neverness To Everness",
        repo_url=NTE_REPO_URL,
        default_config_dir=NTE_CONFIG_DIR,
        default_cache_dir=NTE_CACHE_DIR,
        default_preset="Config 3",
        common_files=NTE_COMMON_FILES,
        read_only=True,
    )
    engine.run_cli()

if __name__ == "__main__":
    main()
